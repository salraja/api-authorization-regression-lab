{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "API Authorization Regression Lab",
          "version": "0.1.0",
          "rules": [
            {
              "id": "AUTHZ001",
              "name": "AuthorizationPolicyRegression",
              "shortDescription": {
                "text": "The API response violated the expected access policy"
              },
              "help": {
                "text": "Enforce tenant and ownership checks before returning or changing protected objects."
              },
              "properties": {
                "tags": [
                  "security",
                  "authorization",
                  "CWE-639"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "AUTHZ001",
          "level": "error",
          "message": {
            "text": "Another member of the same tenant cannot read an owner's invoice. Expected HTTP 403, received 200; response contract matches: True; readback matches: True; unauthorized state change: False."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "authzlab/cases.py",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
